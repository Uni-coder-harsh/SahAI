{
  "name": "vscode-sahai-lens",
  "displayName": "SahAI Lens - Socratic DSA Tutor",
  "description": "Socratic tutor mapping DSA concepts, tracking telemetry, and exposing inline CodeGemma diagnostics.",
  "version": "1.0.0",
  "publisher": "sahai",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Education",
    "Linters",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:cpp",
    "onLanguage:java",
    "onLanguage:javascript"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sahai.setProblemContext",
        "title": "SahAI: Set Target Problem Context"
      }
    ],
    "configuration": {
      "title": "SahAI Lens",
      "properties": {
        "sahaiLens.backendUrl": {
          "type": "string",
          "default": "https://sahai-api-node-production-f2f3.up.railway.app",
          "description": "Backend API URL for SahAI platform."
        },
        "sahaiLens.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Local Ollama server endpoint."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.75.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "axios": "^1.3.4"
  }
}
